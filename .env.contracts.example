# ============================================
# SMART CONTRACTS CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# RPC URLs (Get from Alchemy or Infura)
# ============================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# ============================================
# Private Keys (KEEP THESE SECRET!)
# ============================================
# Deployer wallet (needs ETH for gas on testnet/mainnet)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Backend wallet (for automated contract calls)
BACKEND_PRIVATE_KEY=your_backend_private_key_here

# ============================================
# Contract Verification
# ============================================
# Get API key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Gas Reporting
# ============================================
# Set to "true" to enable gas reporting during tests
REPORT_GAS=false

# Get API key from https://coinmarketcap.com/api/ (optional)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ============================================
# Token Configuration
# ============================================
# Total supply of GRT tokens (default: 1 billion)
TOKEN_TOTAL_SUPPLY=1000000000

# Token name and symbol
TOKEN_NAME=GlobeRise Token
TOKEN_SYMBOL=GRT

# ============================================
# Platform Configuration
# ============================================
# Minimum investment amount in GRT (default: 100 GRT)
MIN_INVESTMENT=100

# Maximum direct referrals per user (default: 16)
MAX_DIRECT_REFERRALS=16

# Withdrawal cooldown in seconds (default: 7 days = 604800)
WITHDRAWAL_COOLDOWN=604800

# Minimum withdrawal amount in GRT (default: 10 GRT)
MIN_WITHDRAWAL=10

# ============================================
# Uniswap Configuration (for DEX integration)
# ============================================
# Uniswap V2 Router address
# Mainnet: 0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
# Sepolia: Deploy mock or use testnet DEX
UNISWAP_V2_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D

# WETH address
# Mainnet: 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# Sepolia: Check testnet docs
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# USDT address
# Mainnet: 0xdAC17F958D2ee523a2206206994597C13D831ec7
# Sepolia: Deploy mock or use testnet token
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ============================================
# Chainlink Price Feed (for accurate USD pricing)
# ============================================
# GRT/USD Price Feed (if available, otherwise use ETH/USD)
# Mainnet ETH/USD: 0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
CHAINLINK_PRICE_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# ============================================
# Security Configuration
# ============================================
# Enable emergency pause on deployment (default: false)
INITIAL_PAUSE_STATE=false

# Gnosis Safe multi-sig address (for admin role transfer)
MULTISIG_ADMIN_ADDRESS=
