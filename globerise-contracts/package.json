{
  "name": "globerise-contracts",
  "version": "1.0.0",
  "description": "GlobeRise Smart Contracts - Solidity contracts for the GlobeRise MLM platform",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "upgrade:sepolia": "hardhat run scripts/upgrade.ts --network sepolia",
    "clean": "hardhat clean && rm -rf typechain-types"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/node": "^20.10.5",
    "dotenv": "^16.3.1",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}

