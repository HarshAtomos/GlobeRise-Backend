generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum WalletType {
  DEPOSIT
  REWARD
  WITHDRAWAL
}

enum TransactionType {
  DEPOSIT        // External -> Fiat
  TRANSFER       // Wallet -> Wallet
  INVESTMENT     // Fiat -> Deposit/Staking
  ROI            // System -> Reward
  COMMISSION     // System -> Reward (Referral/Level/Bonus)
  WITHDRAWAL     // Withdrawal -> External
  ADMIN_ADJUST   // Admin manual credit/debit
  STAKING_RETURN // Staking -> Reward (Maturity)
  ROYALTY        // System -> Reward (Monthly)
  RANK_BONUS     // System -> Reward (One-time)
}

enum TransactionStatus {
  COMPLETED
  PENDING
  REJECTED
  FAILED
}

enum InvestmentType {
  PACKAGE        // Deposit Wallet (MLM Active)
  FIXED          // Staking Wallet (Fixed Term)
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Removed Rank Enum - Now Dynamic (String)

model User {
  id                          String         @id @default(cuid())
  email                       String         @unique
  password_hash               String?
  google_id                   String?        @unique
  is_verified                 Boolean        @default(false)
  verification_token          String?        @unique
  verification_token_expires  DateTime?
  role                        UserRole       @default(USER)
  two_factor_enabled          Boolean        @default(false)
  password_reset_token        String?        @unique
  password_reset_expires      DateTime?
  created_at                  DateTime       @default(now())
  updated_at                  DateTime       @updatedAt

  // MLM Rank (Stored as String, references RankConfig.name)
  rank                        String         @default("NONE")

  // Relations
  profile                UserProfile?
  refreshTokens          RefreshToken[]
  passwordResets         PasswordReset[]
  sessions               UserSession[]
  twoFactorAuth          TwoFactorAuth?
  
  // Referral program
  referralCode                String?        @unique
  referredById                String?
  referrer                    User?          @relation("Referrals", fields: [referredById], references: [id])
  referrals                   User[]         @relation("Referrals")
  
  // Financials
  wallets                 UserWallets?
  transactions            WalletTransaction[]
  investments             Investment[]
  rankHistory             RankHistory[]
  businessSnapshots       BusinessSnapshot[]
  
  // New relations
  notifications           Notification[]
  linkedWallets           LinkedWallet[]
  supportTickets          SupportTicket[]

  @@index([email])
  @@index([google_id])
  @@index([verification_token])
  @@index([password_reset_token])
  @@index([referralCode])
  @@index([referredById])
  @@index([rank])
}

// Dynamic Configuration for MLM Plan
// Allows Admin to update percentages and thresholds without code changes

model PlanConfig {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "GLOBAL_SETTINGS"
  
  // Level Income Configuration
  // JSON: { "1": 10, "2": 5, ... "16": 1 }
  levelIncomeRates Json 

  // Global Settings
  withdrawalFeePercent Decimal @default(10.0) @db.Decimal(5, 2)
  minWithdrawalAmount  Decimal @default(10.0) @db.Decimal(20, 8)
  
  updatedAt   DateTime @updatedAt
}

model RankConfig {
  id               String   @id @default(cuid())
  name             String   @unique // e.g. "NAVIGATOR"
  order            Int      @unique // 1, 2, 3... for hierarchy comparison
  
  requiredBusiness Decimal  @db.Decimal(20, 8) // e.g. 100,000
  
  // One-time Bonus
  bonusAmount      Decimal  @default(0.0) @db.Decimal(20, 8)
  
  // Royalty
  royaltyPercent   Decimal  @default(0.0) @db.Decimal(5, 2) // % of CTO
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([order])
}

model UserWallets {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // The 3 Wallets
  depositBalance    Decimal  @default(0.0)  @db.Decimal(20, 8) // User deposits from linked wallets
  rewardBalance     Decimal  @default(0.0)  @db.Decimal(20, 8) // All ROI and income
  withdrawalBalance Decimal  @default(0.0)  @db.Decimal(20, 8) // Ready for withdrawal to linked wallet

  updatedAt         DateTime @updatedAt
}

model WalletTransaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount          Decimal         @db.Decimal(20, 8)
  type            TransactionType
  status          TransactionStatus @default(COMPLETED)
  
  sourceWallet    WalletType?
  destWallet      WalletType?
  description     String?
  
  // Audit / Source Tracking
  referenceId     String?         // ID of User, Investment, or External Tx
  referenceType   String?         // "USER", "INVESTMENT", "EXTERNAL"
  metadata        Json?           // Extra details (Level, source user info, etc)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Investment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount          Decimal          @db.Decimal(20, 8)
  type            InvestmentType
  status          InvestmentStatus @default(ACTIVE)
  
  roiRate         Decimal          @default(0.0) @db.Decimal(5, 2) // e.g., 8.00 for 8%
  durationDays    Int              @default(30)
  
  startDate       DateTime         @default(now())
  lastRoiDate     DateTime?
  endDate         DateTime?        // For fixed term

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  username        String?
  phone           String?
  phoneCountryCode String?  // e.g., "+1", "+44"
  avatarUrl       String?
  profilePhotoId  String?   @unique
  profilePhoto    ProfilePhoto? @relation(fields: [profilePhotoId], references: [id])
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([username])
}

// Profile Photo with Admin Approval
enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfilePhoto {
  id          String        @id @default(cuid())
  userId      String        @unique
  userProfile UserProfile?
  photoUrl    String
  status      PhotoStatus   @default(PENDING)
  adminNotes  String?       @db.Text
  reviewedBy  String?       // Admin user ID
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// Tracks Rank Promotions
model RankHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rank        String   // Changed from Enum to String
  achievedAt  DateTime @default(now())
  
  // Snapshot of qualification data at time of achievement
  totalBusiness Decimal @db.Decimal(20, 8)
  strongestLeg  Decimal @db.Decimal(20, 8)
  otherLegs     Decimal @db.Decimal(20, 8)

  @@index([userId])
  @@index([rank])
}

// Monthly Snapshot for Growth Logic (Royalty)
model BusinessSnapshot {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  month         Int      // 1-12
  year          Int      // e.g. 2025
  
  totalTeamBusiness Decimal @db.Decimal(20, 8)
  
  createdAt     DateTime @default(now())

  @@unique([userId, month, year]) // One snapshot per user per month
  @@index([userId])
}

model RefreshToken {
  id           String        @id @default(cuid())
  token        String        @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  lastUsedAt   DateTime      @default(now())
  isRevoked    Boolean       @default(false)
  
  // Relations
  sessions     UserSession[]

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model UserSession {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenId  String
  refreshToken    RefreshToken  @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)
  ipAddress       String?
  userAgent       String?
  lastActivityAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([refreshTokenId])
  @@index([lastActivityAt])
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String
  backupCodes String[] // Array of hashed backup codes
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Token Rates for Live Rates Display
model TokenRate {
  id          String   @id @default(cuid())
  symbol      String   @unique // USDT, GRT, FLUFFY
  price       Decimal  @db.Decimal(20, 8)
  change24h   Decimal? @db.Decimal(10, 4) // Percentage change
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([symbol])
}

// Notifications System
enum NotificationType {
  ROI_CREDIT
  COMMISSION
  RANK_PROMOTION
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  INVESTMENT_CREATED
  STAKING_MATURED
  ROYALTY_DISTRIBUTED
  SYSTEM
  ANNOUNCEMENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?            // Extra data (amount, referenceId, etc)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// Announcements System
enum AnnouncementType {
  OFFER
  UPDATE
  MAINTENANCE
  GENERAL
}

model Announcement {
  id          String            @id @default(cuid())
  title       String
  content     String            @db.Text
  type        AnnouncementType
  priority    Int               @default(0) // Higher = more important
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime?
  createdBy   String?           // Admin user ID

  @@index([active])
  @@index([expiresAt])
  @@index([createdAt])
}

// Linked Wallets (MetaMask, Trust Wallet)
enum WalletProvider {
  METAMASK
  TRUST_WALLET
}

model LinkedWallet {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String          // Wallet address
  provider    WalletProvider
  chainId     Int             // Network chain ID
  isActive    Boolean         @default(true)
  linkedAt    DateTime        @default(now())
  lastSynced  DateTime?       // Last time balances were synced

  @@unique([userId, address, chainId]) // One link per user-address-chain combo
  @@index([userId])
  @@index([address])
  @@index([isActive])
}

// Support Tickets
enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  FINANCIAL
  ACCOUNT
  INVESTMENT
  WITHDRAWAL
  OTHER
}

model SupportTicket {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      TicketCategory
  subject       String
  message       String          @db.Text
  status        TicketStatus    @default(OPEN)
  priority      TicketPriority  @default(MEDIUM)
  adminResponse String?         @db.Text
  respondedBy   String?         // Admin user ID
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// FAQ
model FAQ {
  id          String          @id @default(cuid())
  category    TicketCategory
  question    String
  answer      String          @db.Text
  order       Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([active])
}

// Rules
enum RuleCategory {
  INVESTMENT
  REWARDS
  WITHDRAWAL
  RANKING
  REFERRAL
  GENERAL
}

model Rule {
  id          String          @id @default(cuid())
  category    RuleCategory
  title       String
  content     String          @db.Text
  order       Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([active])
}
